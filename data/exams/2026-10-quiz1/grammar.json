{
  "title": "Grammar — Present and Past: Be; Present Simple (My Next Grammar, Lessons 4-5)",
  "intro": "Lesson 4: am / is / are and was / were. Lesson 5: present simple verbs and subject-verb agreement (SVA). Practice items are built from the M1W1 HW2 and M1W2 HW2 homework formats.",
  "explanation": {
    "title": "Be Verbs and Present Simple Quick Guide",
    "intro": "這次 Grammar 考兩件事：be 動詞的現在式和過去式，以及一般現在式動詞要不要加 -s / 用 do 還是 does。",
    "cards": [
      {
        "term": "Be — Present",
        "formula": "I am / he, she, it is / you, we, they are",
        "meaning": "現在的狀態。主詞是 I 用 am；單數第三人稱（he / she / it / 一個人或東西）用 is；you / 複數用 are。",
        "examples": [
          "I am ten years old.",
          "The weather is sunny now.",
          "Those girls are so mean to the new student.",
          "There are many reasons to brush your teeth."
        ],
        "verbs": [
          "am",
          "is",
          "are"
        ]
      },
      {
        "term": "Be — Past",
        "formula": "I, he, she, it was / you, we, they were",
        "meaning": "過去的狀態。單數用 was，複數和 you 用 were。句子裡有 yesterday、last night、this morning、ago 常常是過去式。",
        "examples": [
          "The cat was hungry this morning.",
          "Where were you when I called last night?",
          "There was a storm last night."
        ],
        "verbs": [
          "was",
          "were"
        ]
      },
      {
        "term": "Be — Negative & Question",
        "formula": "isn't / aren't / wasn't / weren't · Is he…? Are they…? Was it…? Were you…?",
        "meaning": "否定在 be 後面加 not；問句把 be 搬到主詞前面。be 動詞不需要 do / does。",
        "examples": [
          "Why aren't you talking?",
          "Is it your birthday today?",
          "The answers on the test aren't correct."
        ],
        "verbs": [
          "isn't",
          "aren't",
          "wasn't",
          "weren't"
        ]
      },
      {
        "term": "Present Simple — Verb + s",
        "formula": "he / she / it + verb-s (listens, goes, washes, cries)",
        "meaning": "一般現在式說習慣或事實。第三人稱單數動詞要加 -s；字尾 sh / ch / s / x / o 加 -es；子音 + y 改成 -ies。",
        "examples": [
          "Sherry listens carefully in class.",
          "Tom washes the dishes after dinner.",
          "The baby cries a lot.",
          "My mom goes to work by MRT."
        ],
        "verbs": [
          "listens",
          "goes",
          "washes",
          "cries",
          "has",
          "does"
        ]
      },
      {
        "term": "Present Simple — No s",
        "formula": "I / you / we / they + verb",
        "meaning": "主詞是 I、you、複數（Jimmy and Alexia、most people、cats）動詞不加 -s。",
        "examples": [
          "Jimmy and Alexia understand the rules of the game.",
          "Cats like milk.",
          "I firmly believe that you can achieve your goals."
        ],
        "verbs": [
          "understand",
          "like",
          "believe"
        ]
      },
      {
        "term": "Present Simple — do / does",
        "formula": "does not + verb (he/she/it) · do not + verb (I/you/we/they) · Does he…? Do they…?",
        "meaning": "否定和問句用 do / does 幫忙，後面的動詞回到原形，不再加 -s。",
        "examples": [
          "My sister does not drink coffee.",
          "Most people from England do not speak Japanese.",
          "Does your dad work on Saturdays?",
          "Do they like pizza?"
        ],
        "verbs": [
          "do not",
          "does not",
          "don't",
          "doesn't"
        ]
      }
    ],
    "tips": [
      "先找主詞：一個人或東西（he / she / it / Sherry / the cat）→ is / was / verb-s / does。",
      "兩個以上或 you（Jimmy and Alexia / they / most people）→ are / were / 原形動詞 / do。",
      "there is / there are 看後面的名詞：There is a book. / There are many reasons.",
      "看到 does not 或 do not，後面動詞一定是原形：She does not drink（不是 drinks）。",
      "時間線索：now / every day / always → 現在；yesterday / last night / this morning / ago → 過去 was / were。"
    ]
  },
